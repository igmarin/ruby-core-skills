{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Eval Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "target_type", "target_name", "context_mode", "requires_companion_resources"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "target_type": {
      "type": "string",
      "enum": ["skill", "persona"]
    },
    "target_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "context_mode": {
      "type": "string",
      "enum": ["skill_bundle_xml"]
    },
    "requires_companion_resources": {
      "type": "boolean",
      "default": true
    }
  }
}
